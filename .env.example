NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/mcp
MCP_CONNECTIONS_ENABLED=false
MCP_WRITES_ENABLED=false
# Development without Supabase may use `off`. Production must explicitly use
# `prepare`, `required`, or emergency `read-only` with valid server-only keys.
PROJECT_ENCRYPTION_MODE=off
PROJECT_ENCRYPTION_ACTIVE_KEY_ID=local-v1
PROJECT_ENCRYPTION_KEYS={"local-v1":"BASE64_ENCODED_32_BYTE_KEY"}
